{
	// Visit https://aka.ms/tsconfig to read more about this file
	"compilerOptions": {
		// Environment Settings
		// See also https://aka.ms/tsconfig/module
		"target": "ES2020",          // Modern JS features
    "module": "ESNext",          // Keeps ES module syntax
    "moduleResolution": "node",  // Resolve imports like Node
    "outDir": "./dist",            // Compiled JS output folder
    "rootDir": "./src",            // Your TS source folder
    "esModuleInterop": true,     // Allows default imports from CommonJS
		"forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
		// "types": [],
		// For nodejs:
		"lib": ["esnext"],
		"types": ["node"],

		// Other Outputs
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,

		// Stricter Typechecking Options
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,

		// Style Options
		// "noImplicitReturns": true,
		// "noImplicitOverride": true,
		// "noUnusedLocals": true,
		// "noUnusedParameters": true,
		// "noFallthroughCasesInSwitch": true,
		// "noPropertyAccessFromIndexSignature": true,

		// Recommended Options
		"jsx": "react-jsx",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
	},
	"include": ["src/**/*"],
	"ts-node": {
		"esm": true, // Enable ESM support in ts-node
		"transpileOnly": true,
    "files": true,
    // Tell ts-node CLI to install the --loader automatically, explained below
    "compilerOptions": {
      "module": "ESNext"
    }
	}
}
